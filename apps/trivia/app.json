{
  "schema": "puffpai_app/v1",
  "id": "trivia",
  "name": "Trivia",
  "blurb": "Question rounds and scores, for when the room needs something to do.",
  "version": "1.0.0",
  "author": "Cypher Sisters",
  "license": "Apache-2.0",
  "order": 50,
  "first_app": true,

  "surfaces": ["daily.games"],

  "data": { "default": { "results": [], "last_updated": "" } },

  "ui": { "route": "/dashboard/apps/trivia", "icon": "mdiHelpCircle" },

  "vocabulary": {
    "keywords": [
      "trivia",
      "quiz"
    ],
    "examples": [
      "what are the trivia scores"
    ]
  },

  "actions": [
    { "id": "trivia_get_stats", "says": "what are the trivia scores" }
  ],

  "doors": [
    {
      "hosts": [],
      "purpose": "None. Questions are written by the model on this box.",
      "data_sent_plain": "nothing"
    }
  ],
  "credential": { "kind": "none" },
  "children": { "may_be_used_by_minor": true },

  "requires": { "home_assistant": false, "network": false, "ollama": true }
}
