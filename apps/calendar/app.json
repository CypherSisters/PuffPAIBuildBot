{
  "schema": "puffpai_app/v1",
  "id": "calendar",
  "name": "Calendar",
  "blurb": "Your events and to-dos on one month view.",
  "version": "1.0.0",
  "author": "Cypher Sisters",
  "license": "Apache-2.0",
  "order": 20,
  "first_app": true,

  "surfaces": ["comms.calendar"],

  "data": {
    "default": {
      "family": [
        { "id": "me", "name": "Me", "color": "#38bdf8", "emoji": "\ud83d\ude42", "role": "parent" }
      ],
      "events": [],
      "tasks": [],
      "meds": [],
      "bills": [],
      "last_updated": ""
    }
  },

  "ui": { "route": "/dashboard/apps/calendar", "icon": "mdiCalendar" },

  "vocabulary": {
    "keywords": [
      "calendar",
      "schedule",
      "event",
      "appointment",
      "meeting",
      "task",
      "to do",
      "todo"
    ],
    "examples": [
      "what is on my calendar tomorrow"
    ]
  },

  "actions": [
    { "id": "cal_add_event", "says": "add a dentist appointment on friday at ten" },
    { "id": "cal_list_events", "says": "what is on my calendar tomorrow" },
    { "id": "cal_add_task", "says": "add taking the bins out to my tasks" }
  ],

  "doors": [
    {
      "hosts": [],
      "purpose": "None. The calendar is held on this computer only.",
      "data_sent_plain": "nothing"
    }
  ],
  "credential": { "kind": "none" },
  "children": { "may_be_used_by_minor": true },

  "requires": { "home_assistant": false, "network": false, "ollama": false }
}
