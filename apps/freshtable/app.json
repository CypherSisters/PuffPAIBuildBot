{
  "schema": "puffpai_app/v1",
  "id": "freshtable",
  "name": "FreshTable",
  "blurb": "Pantry, shopping list, meal plan and the recipes behind them.",
  "version": "1.0.0",
  "author": "Cypher Sisters",
  "license": "Apache-2.0",
  "order": 30,
  "first_app": true,

  "surfaces": ["daily.kitchen"],

  "data": {
    "default": {
      "pantry": [],
      "shoppingList": [],
      "mealPlan": [],
      "recipes": [],
      "last_updated": ""
    }
  },

  "ui": { "route": "/dashboard/apps/freshtable", "icon": "mdiFood", "widget": "meals" },

  "vocabulary": {
    "keywords": [
      "pantry",
      "shopping list",
      "grocery",
      "meal plan"
    ],
    "examples": [
      "add milk to the shopping list",
      "what is in the pantry"
    ]
  },

  "actions": [
    { "id": "fresh_add_shopping", "says": "add milk to the shopping list" },
    { "id": "fresh_list_shopping", "says": "what is on the shopping list" },
    { "id": "fresh_add_pantry", "says": "add a bag of rice to the pantry" },
    { "id": "fresh_list_pantry", "says": "what is in the pantry" }
  ],

  "doors": [
    {
      "hosts": [],
      "purpose": "None. Recipe help is answered by the model on this box.",
      "data_sent_plain": "nothing"
    }
  ],
  "credential": { "kind": "none" },
  "children": { "may_be_used_by_minor": true },

  "requires": { "home_assistant": false, "network": false, "ollama": true }
}
