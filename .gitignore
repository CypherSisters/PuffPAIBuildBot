# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
# ...but the build package and its test fixtures are source (puffpai.build)
!src/puffpai/build/
!tests/fixtures/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/
.venv

# User Data — NEVER COMMIT THESE!
data/
# Belt and braces: the legacy in-checkout API key file. New installs keep it in
# the per-user state dir (puffpai.config.get_state_dir) and the backend migrates
# an old copy out on first start, but an existing one must never be committed.
data/api_key.txt
# ...but the generic default workout library shipped as package data IS tracked
# (runtime files written into src/puffpai/data/ stay ignored).
!src/puffpai/data/
src/puffpai/data/*
!src/puffpai/data/workout_library.json
app_data/
chat_history/
feedback_data.jsonl
blocked_devices.json

# Local config (copy the .example.json templates instead)
# The wizard writes these real files; only *.example.json stays tracked.
config/puffpai_config.json
config/home_assistant_config.json
config/media_server_config.json
config/profiles.json

# Kiwix / knowledge data
kiwix_rag_db/
*.zim
kiwix-library.xml

# AI Models (too large for git)
*.gguf
*.bin
*.safetensors
models/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
*.code-workspace

# OS
Thumbs.db
*.log

# Secrets & Keys — never commit vault material or credentials
*.key
*.pem
.env
.env.*
*.env
secrets/
vault_data/
# The vault inbox (items sealed while the vault is locked) sits beside the
# vault folder, as <vault folder>.inbox.
vault_data.inbox/
*.inbox/
# Where the vault should be (security/vault.py remember_place).
vault_place.json
.vault_key_salt

# Runtime logs & state
logs/
security_logs/
src/security_logs/
*.pid
debug_*.png
node_modules/

# Test / type-check artifacts
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.cover

# Temporary files
*.tmp
*.bak
*~
.cache/
assets/

# Dashboard (Next.js) build + dependency artifacts
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/tsconfig.tsbuildinfo
# Dashboard env files hold real secrets — never commit them, but keep the template.
dashboard/.env*
!dashboard/.env.example

# Written by the installers for ONE machine: absolute paths and this install's
# ports baked in. Regenerated by re-running install.ps1 / install.sh.
/run-setup.ps1
/run-setup.sh
/run-backend.ps1
/run-backend.sh
/run-dashboard.ps1
/run-dashboard.sh
/run-start.ps1
/run-stop.ps1
/Start *.cmd
/Stop *.cmd
/Set up BuildBot.cmd
/puffpai.cmd
/start-bot.sh
/stop-bot.sh
/start-ollama.sh
/Start BuildBot.command
/Stop BuildBot.command
/node_path.txt
/puffpai
# --state-dir ./state, the suggested way to keep an install's own footprint.
/state/
# The installers' pointer at the checkout root: this machine's absolute path to
# this install's buildbot.env, read by a bare `puffpai` command.
/.puffpai-install.json

# The installer's own log of its last run
install-log.txt
