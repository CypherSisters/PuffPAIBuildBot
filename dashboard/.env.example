# ─────────────────────────────────────────────────────────────────────────────
# PuffPAI Dashboard — environment template
#
# Copy this file to `.env.local` (which is git-ignored) and fill in the values.
# The dashboard is a thin UI over the PuffPAI backend (`puffpai serve`); every
# request to a protected backend endpoint is proxied through the Next.js server
# (app/api/pai/[...path]) so the API key never reaches the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend connection (server-side only — never sent to the browser) ─────────

# Where the PuffPAI REST API is listening. Started with `puffpai serve`.
PUFFPAI_BACKEND_URL=http://localhost:8000

# The PuffPAI app API key. Get the ACTIVE key the server accepts by running,
# from the backend repo root:
#     puffpai apikey
# and paste its output here. (Background: an explicitly set PUFFPAI_API_KEY
# environment variable wins; otherwise the backend stores the key in the OS
# keyring — service "puffpai", entry "PUFFPAI_API_KEY" — or, as a fallback, in
# data/api_key.txt. Reading the file directly can give you a stale key;
# `puffpai apikey` always resolves the one the server will actually accept.)
PUFFPAI_API_KEY=paste-your-backend-api-key-here

# ── Zero telemetry ────────────────────────────────────────────────────────────
# Next.js sends anonymous usage reports to its maker unless this is set. BuildBot
# promises zero telemetry; the installers and launchers set it too.
NEXT_TELEMETRY_DISABLED=1

# ── Client-side settings (compiled into the browser bundle — no secrets!) ─────
#
# NEVER add a NEXT_PUBLIC_API_KEY here or in .env.local. Next INLINES every
# NEXT_PUBLIC_* variable into the JavaScript it sends to the browser, so setting
# that one would publish your backend key to every device on your network. No
# code reads it any more, and the proxy below is what supplies the key. If you
# have it in an existing .env.local, delete the line and then delete the build
# cache (rm -rf .next), which keeps a copy of the value it was built with.

# There is deliberately NO setting for the browser's API base. It is hardcoded
# to the same-origin path /api/pai in app/_lib/api.ts, because a configurable
# base is a way to route browser calls around the proxy — and so around the
# pairing gate, the path allowlist and the cross-site check — while still
# sending vault session headers to whatever host was named. Nothing reads
# NEXT_PUBLIC_API_URL any more; if you have it in an existing .env.local you can
# delete the line.

# Version string shown by /api/health.
NEXT_PUBLIC_VERSION=0.1.0-alpha

# ── Optional: Home Assistant camera snapshots (server-side only) ──────────────
# Only needed if you use the Security Cameras widget with Home Assistant.
# HA_BASE_URL=http://homeassistant.local:8123
# HA_ACCESS_TOKEN=your-home-assistant-long-lived-access-token

# ── Optional: Jellyfin / media server (LAN only) ──────────────────────────────
# The Media page iframes a loopback proxy (see instrumentation.ts) that forwards
# to your media server so browser Local-Network-Access rules don't block it.
# JELLYFIN_LAN_HOST=media-server.local   # mDNS host or LAN hostname of the server
# JELLYFIN_LAN_IP=192.0.2.10             # last-known LAN IP (proxy fallback)
# JELLYFIN_PROXY_PORT=8096               # local loopback port the proxy listens on
# NEXT_PUBLIC_JELLYFIN_URL=http://localhost:8096  # iframe/base URL for the Media page
# MEDIA_SERVER_URL=http://media-server.local:8096 # extra CSP frame/img origin (direct LAN)
